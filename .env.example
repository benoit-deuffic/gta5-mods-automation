# Meshy AI credentials (laisser vide => mode mock automatique)
MESHY_API_KEY=""
MESHY_API_BASE_URL="https://api.meshy.ai"

# Force le mode mock même si une clé/binaire est présent (debug) : "1" ou "0"
PIPELINE_MOCK="auto"

# Blender (laisser vide => recherche "blender" sur le PATH ; absent => mock)
BLENDER_EXECUTABLE_PATH=""

# CodeWalker.Core CLI (.NET) pour la conversion XML -> binaire RAGE (absent => mock)
CODEWALKER_CLI_PATH=""

# Dossier de travail (staging, assets intermédiaires)
PIPELINE_WORKSPACE_DIR="./workspace"

# Dossier de sortie des paquets de livraison (zip/.oiv) à installer manuellement côté jeu
DELIVERY_OUTPUT_DIR="./dist"

# Templates de ped de base (doivent être extraits par l'utilisateur de SA copie du jeu,
# voir templates/README.md) :
TEMPLATE_FEMALE_PATH="templates/template_female_a_f_y_business_02.blend"
TEMPLATE_MALE_PATH="templates/template_male_a_m_y_business_02.blend"

# Backend de génération 3D : "meshy" (cloud, défaut), "tripo" (Tripo3D, cloud)
# ou "local" (TripoSR/Hunyuan3D-2, nécessite un GPU CUDA, voir scripts/bootstrap_local_3d_env.sh)
TEXT3D_BACKEND="meshy"

# Tripo3D credentials (clé préfixée "tsk_", PAS "msy_" -- ne pas confondre avec Meshy,
# voir docs/architecture-decisions.md point 9)
TRIPO_API_KEY=""

# Ollama (LLM local pour enrichir le prompt texte avant génération 3D — ne remplace
# PAS la génération 3D elle-même, voir docs/architecture-decisions.md point 7).
# Lancer scripts/bootstrap_ollama.sh pour installer Ollama + tirer les modèles
# adaptés au matériel détecté ; config/ollama.json est généré automatiquement.
OLLAMA_ENDPOINT="http://127.0.0.1:11434"
OLLAMA_TEXT_MODEL=""

