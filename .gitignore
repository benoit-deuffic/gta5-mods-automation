.venv/
.venv-local3d/
__pycache__/
*.pyc
.env
*.egg-info/
.pytest_cache/
dist/
build/
workspace/

# .NET / CodeWalker CLI build artifacts (not vendored/committed, see
# docs/architecture-decisions.md point 10 and scripts/fetch_codewalker.sh)
third_party/
tools/CodeWalkerCli/bin/
tools/CodeWalkerCli/obj/
tools/CodeWalkerCli/publish/
*.dll
*.pdb

# Host-specific generated state (hardware profile differs per machine,
# see scripts/bootstrap_ollama.sh / scripts/hw_detect.py) -- never the
# repo's source of truth, just local runtime output.
config/ollama.json
workspace_ollama_serve.log

# NEVER commit extracted Rockstar game assets (hard rule, see
# docs/analyse-prerequis.md and the gtav-ped-modding skill). Extracted base
# ped files (.ydd/.yft/.ymt/.ytd/.yed/.awc from CodeWalker/OpenIV) must stay
# local to the machine that extracted them, never pushed to the repo.
peds/
import/
import_xml/
*.rpf
templates/*.blend
templates/*.blend1
# assembled test .blend files embed extracted game/mod meshes and textures
output_test*.blend
*.blend1
