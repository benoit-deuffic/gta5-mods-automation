<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>codewalker-cli</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Build-time dependency, fetched by scripts/fetch_codewalker.sh into
         third_party/CodeWalker (gitignored, not vendored; see
         docs/architecture-decisions.md point 10). Run that script first. -->
    <ProjectReference Include="../../third_party/CodeWalker/CodeWalker.Core/CodeWalker.Core.csproj" />
  </ItemGroup>
</Project>
